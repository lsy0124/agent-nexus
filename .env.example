# Reference only: Nexus does not automatically load this file or a .env file.
# Set these as process environment variables before launching the server.
# A comma-only NEXUS_AGENTS disables real model adapters for an offline exploration.
NEXUS_AGENTS=,
NEXUS_KEY_VAULT=memory
# Optional browser test override; point at an existing browser, never a download.
# NEXUS_BROWSER_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Never put API keys, OAuth credentials or account IDs in this example.
